local function f<T, U>(t: T, u: U)
  return {a = t, b = u}
end

local t: {a: string, b: number} = f("a", 123)

local function g<T>()
  local function d<U>(t: T, u: U)
    return t, u
  end
  local a: T, b: number = d(123, 456)
end

local function insert<T>(t: T[], item: T)
  t[#t + 1] = item
end

local arr = {1, 2, 3}

insert(arr, 123)
insert(arr, "a")
